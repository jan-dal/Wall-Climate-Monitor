        "IDF_TARGET": "esp32s3",
        "SDKCONFIG": "build/qemu/sdkconfig",
        "SDKCONFIG_DEFAULTS": "config/sdkconfig.common;config/sdkconfig.qemu"
      }
    }
  ]
}
